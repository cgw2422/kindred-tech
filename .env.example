# ---------------------------------------------------------------------------
# Kindred Tech Support - environment variables
# Copy to .env for local development. Never commit real secrets.
# Integrations are optional: when a value is missing the app keeps working and
# shows the feature as "not configured" (no fake payments, emails, or estimates).
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------
# PostgreSQL connection string (Railway provides this as DATABASE_URL)
DATABASE_URL="postgresql://kindred:kindred@localhost:5432/kindred_dev"
# Public base URL of the site, no trailing slash (used in emails and redirects)
APP_URL="http://localhost:3000"

# First owner account (used by `npm run db:seed`) ---------------------------
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="Owner"
# Required in production; in development defaults to KindredDev!2026
SEED_OWNER_PASSWORD=""
# Set to "false" to skip sample customers/facility in development seeds
SEED_SAMPLE_DATA="true"
# Docker/Railway: run the (idempotent) seed automatically when the web container starts
SEED_ON_START="false"

# Email (Resend) -------------------------------------------------------------
RESEND_API_KEY=""
# Verified sender, e.g. "Kindred Tech Support <hello@yourdomain.com>"
EMAIL_FROM=""
EMAIL_REPLY_TO=""
# disabled | allowlist | live   (default: disabled - nothing is sent)
EMAIL_DELIVERY_MODE="disabled"
# Comma-separated recipients allowed when EMAIL_DELIVERY_MODE=allowlist
EMAIL_ALLOWLIST=""

# Payments (Stripe) ----------------------------------------------------------
STRIPE_SECRET_KEY=""
# Signing secret for the endpoint https://<APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Maps (choose one; Google takes precedence) ---------------------------------
# Needs Geocoding API + Distance Matrix API enabled. Server-side key.
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# S3-compatible storage (optional, reserved for future file uploads) --------
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Scheduler ------------------------------------------------------------------
# Bearer secret for POST /api/cron (alternative to running the worker service)
CRON_SECRET=""
# Worker polling interval in ms (default 30000)
WORKER_INTERVAL_MS="30000"

# Testing --------------------------------------------------------------------
# Integration tests TRUNCATE this database. It must contain "_test".
TEST_DATABASE_URL="postgresql://kindred:kindred@localhost:5432/kindred_test"
